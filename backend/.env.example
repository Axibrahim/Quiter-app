# ---- Core ----
QUITER_ENV=development
FLASK_SECRET_KEY=
PASSWORD_PEPPER=
DATABASE_URL=postgresql://user:password@host:port/dbname
REDIS_URL=memory://
# Comma-separated list of frontend origins allowed to call the API (no trailing slash)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# Public URL of the FRONTEND. Used for the links inside emails
# (verify, reset password and the "Yes, I'm on track" button).
APP_BASE_URL=http://localhost:5500

# ---- Email (Resend) ----
RESEND_API_KEY=
# Must be an address on a domain you've verified in Resend, e.g. "Quiter <coach@yourdomain.com>".
# The default onboarding@resend.dev only delivers to your own Resend account email.
RESEND_FROM_ADDRESS=Quiter <onboarding@resend.dev>

# ---- Reminder worker (python reminder_worker.py) ----
REMINDER_POLL_SECONDS=60

# ---- AI (Gemini by default). Leave AI_API_KEY empty to use the built-in free templates. ----
AI_API_KEY=
AI_PROVIDER=gemini
# Check Google AI Studio for the current model id; this is the cheap/fast default.
AI_MODEL=gemini-2.5-flash-lite
AI_MODE=milestones
AI_STEADY_EVERY=3
AI_DAILY_CALL_LIMIT=300
AI_TIMEOUT_SECONDS=8
# Only if you pick a Gemini 3.x model (2.5 is handled automatically):
# AI_THINKING_LEVEL=minimal
# Only for OpenAI-compatible hosts (AI_PROVIDER=openai):
# AI_BASE_URL=


# ---- Supabase storage (progress videos + admin plan photos) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PLAN_PHOTOS_BUCKET=plan-photos
SUPABASE_PROGRESS_VIDEOS_BUCKET=progress-videos